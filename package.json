{
  "name": "@underverse-ui/document-preview",
  "version": "0.2.0",
  "description": "React document preview: PDF, Word, Excel, PowerPoint, CSV, Markdown, HTML, code, JSON/XML, images, video, audio and ZIP archives in a dialog sized to the document.",
  "license": "MIT",
  "author": "Tran Van Bach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faker6996/document-preview.git"
  },
  "homepage": "https://github.com/faker6996/document-preview#readme",
  "bugs": {
    "url": "https://github.com/faker6996/document-preview/issues"
  },
  "keywords": [
    "react",
    "document-viewer",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "preview",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:exports",
    "release": "node ./scripts/release.mjs",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:beta": "node ./scripts/release.mjs prerelease --preid=beta",
    "verify:exports": "node ./scripts/verify-exports.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@embedpdf/react-pdf-viewer": "^2.15.1",
    "@js-preview/excel": "^1.7.14",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "marked": "^18.3.0",
    "papaparse": "^5.7.1",
    "pptx-preview": "^1.0.7",
    "prismjs": "^1.30.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
